# Banco SQLite (caminho relativo a prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3333

# Origens do frontend permitidas (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# Login da recepção (usuário e senha fixos). Escolha uma senha forte.
# Em produção são obrigatórios. Em desenvolvimento, se ficarem vazios, o login fica desligado.
ADMIN_USER=recepcao
ADMIN_PASSWORD=troque-esta-senha

# QuartoVerde (Lodgehog). Use uma chave SOMENTE LEITURA. Nunca coloque a chave real neste arquivo.
LODGEHOG_API_KEY=cole-aqui-a-chave-de-leitura
LODGEHOG_BASE_URL=https://api.lodgehog.com/v1

# Dados da pousada usados no PDF (opcionais: já há valores padrão em src/config/pousada.ts)
POUSADA_CNPJ=03.584.561/0001-73
POUSADA_ENDERECO=Rua Evaldo Campos Junior, 564 – Aruana, Aracaju – SE
PIX_CHAVE=03.584.561/0001-73
